  "content": {
    "caseIdentity": "Sharad Birdhichand Sarda v. State of Maharashtra, (1984) 4 SCC 116",
    "court": "Supreme Court of India",
    "decisionYear": 1984,
    "citation": "(1984) 4 SCC 116",
    "facts": "The Court assessed a prosecution based substantially on circumstantial evidence.",
    "questionsBeforeCourt": [
      "What standard must circumstantial evidence meet before it can support a criminal conviction.",
      "What safeguards govern a complete chain of circumstantial evidence?"
    ],
    "ratioDecidendi": "The circumstances must be fully established, consistent only with guilt, conclusive in tendency, and form a complete chain excluding every reasonable hypothesis of innocence.",
    "holding": "The Court restated the safeguards for conviction on circumstantial evidence.",
    "relevance": "Use where s. 1 concerns circumstantial proof or inference; do not use it as a substitute for a section-specific relevancy rule.",
