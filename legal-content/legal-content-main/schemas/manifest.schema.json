{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://legal-content.codepackr.com/schemas/manifest.schema.json",
  "title":"Legal Content Manifest",
  "type":"object",
  "required":["manifestVersion","generatedAt","repository","entities"],
  "properties":{
    "manifestVersion":{"type":"string","pattern":"^v[0-9]+$"},
    "generatedAt":{"type":"string","format":"date-time"},
    "repository":{"type":"string"},
    "entities":{"type":"array","items":{"type":"object","required":["id","entityType","path","version","status"],"properties":{"id":{"type":"string"},"entityType":{"type":"string"},"path":{"type":"string"},"version":{"type":"integer","minimum":1},"status":{"type":"string"},"sha256":{"type":["string","null"]}},"additionalProperties":false}}
  },
  "additionalProperties":false
}