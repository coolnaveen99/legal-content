{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://legal-content.codepackr.com/schemas/judgment.schema.json",
  "title":"Judgment Decoder Record",
  "type":"object",
  "required":["schemaVersion","entityType","id","version","status","title","jurisdiction","content","sources","updatedAt"],
  "properties":{
    "schemaVersion":{"type":"string","pattern":"^v[0-9]+$"},
    "entityType":{"const":"judgment"},
    "id":{"type":"string"},
    "version":{"type":"integer","minimum":1},
    "status":{"type":"string","enum":["draft","research","review","verified","approved","published","review-due","update","archived"]},
    "title":{"type":"string"},
    "jurisdiction":{"type":"string"},
    "content":{
      "type":"object",
      "properties":{
        "caseIdentity":{"type":"string"},
        "court":{"type":"string"},
        "bench":{"type":"string"},
        "date":{"type":["string","null"],"format":"date"},
        "parties":{"type":"array","items":{"type":"string"}},
        "disputeOrigin":{"type":"string"},
        "originalForum":{"type":"string"},
        "proceduralHistory":{"type":"string"},
        "facts":{"type":"string"},
        "argumentsPartyA":{"type":"string"},
        "argumentsPartyB":{"type":"string"},
        "questionsBeforeCourt":{"type":"array","items":{"type":"string"}},
        "lawsInvolved":{"type":"array","items":{"type":"string"}},
        "precedentsReliedUpon":{"type":"array","items":{"type":"string"}},
        "precedentsDistinguishedOrChallenged":{"type":"array","items":{"type":"string"}},
        "courtQuestions":{"type":"array","items":{"type":"string"}},
        "reasoning":{"type":"string"},
        "stepByStepReasoning":{"type":"array","items":{"type":"string"}},
        "findings":{"type":"array","items":{"type":"object","required":["issue","finding"],"properties":{"issue":{"type":"string"},"finding":{"type":"string"}},"additionalProperties":false}},
        "majorityReasoning":{"type":"string"},
        "separateOpinions":{"type":"array","items":{"type":"string"}},
        "holding":{"type":"string"},
        "ratioDecidendi":{"type":"string"},
        "obiter":{"type":"string"},
        "finalOrder":{"type":"string"},
        "legalChange":{"type":"string"},
        "laterJudgments":{"type":"array","items":{"type":"string"}},
        "presentLegalPosition":{"type":"string"},
        "practicalSignificance":{"type":"string"}
      },
      "additionalProperties":true
    },
    "sources":{"type":"array","items":{"type":"string"}},
    "updatedAt":{"type":"string","format":"date-time"},
    "effectiveFrom":{"type":["string","null"],"format":"date"},
    "effectiveTo":{"type":["string","null"],"format":"date"},
    "tags":{"type":"array","items":{"type":"string"}}
  },
  "additionalProperties":false
}